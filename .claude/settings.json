{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git -C * status)",
      "Bash(git -C * status *)",
      "Bash(git -C * log)",
      "Bash(git -C * log *)",
      "Bash(git -C * diff)",
      "Bash(git -C * diff *)",
      "Bash(git -C * show)",
      "Bash(git -C * show *)",
      "Bash(git -C * branch)",
      "Bash(git -C * branch *)",
      "Bash(git -C * remote -v)",
      "Bash(svn status:*)",
      "Bash(svn log:*)",
      "Bash(svn diff:*)",
      "Bash(svn info:*)",
      "Bash(svn list:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(git rebase:*)",
      "Bash(git * rebase)",
      "Bash(git * rebase *)",
      "Bash(git reset:*)",
      "Bash(git * reset)",
      "Bash(git * reset *)",
      "Bash(svn commit:*)",
      "Bash(svn * commit)",
      "Bash(svn * commit *)",
      "Bash(svn ci:*)",
      "Bash(svn * ci)",
      "Bash(svn * ci *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo REMINDER: context is about to be compacted. If docs/2-project-status.md is stale, run the save-context skill first so session state survives compaction."
          }
        ]
      }
    ]
  }
}
