{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(svn status:*)",
      "Bash(svn log:*)",
      "Bash(svn diff:*)",
      "Bash(svn info:*)",
      "Bash(svn list:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(svn commit:*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo REMINDER: context is about to be compacted. If docs/2-project-status.md is stale, run the save-context skill first so session state survives compaction."
          }
        ]
      }
    ]
  }
}
